# ==============================================================================
# DevScope 环境变量模板（开发与生产共用）
# ==============================================================================
# 用法：
#   本地开发：cp .env.example .env，按注释填入本地值
#   生产部署：在生产主机上 cp .env.example .env，替换全部占位值
# 真实凭据只放在 .env（已 gitignore），禁止提交到此文件。

# ============================================================================
# Database
# ============================================================================
# PostgreSQL 独立密码（生产部署必须修改；本地开发可与 DATABASE_URL 保持一致）
POSTGRES_PASSWORD=change-me-before-deploy
# PostgreSQL 数据库连接字符串
# 本地开发指向 localhost；生产部署改为 postgres 容器主机名，并复用上面的密码
DATABASE_URL=postgresql://postgres:change-me-before-deploy@localhost:5432/devscope

# ============================================================================
# AI Services
# ============================================================================

# DeepSeek API (用于 AI 分析)
# 获取方式: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DeepSeek API 地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称: deepseek-chat (通用) 或 deepseek-coder (代码专用)
DEEPSEEK_MODEL=deepseek-chat

# 其他 OpenAI 兼容 API (可选)
# 生产当前默认：MiniMax M3（大陆站 Token Plan）。
# 三行必须同时启用（key 与 baseURL 站点必须匹配）；DEEPSEEK_* 保留为显式回滚配置。
# 国际站 base url 为 https://api.minimax.io/v1，大陆站为 https://api.minimaxi.com/v1
#OPENAI_COMPATIBLE_API_KEY=your-minimax-token-plan-key
#OPENAI_COMPATIBLE_BASE_URL=https://api.minimaxi.com/v1
#OPENAI_COMPATIBLE_MODEL=MiniMax-M3

# GitHub API (用于采集仓库数据)
# 获取方式: https://github.com/settings/tokens
# 需要的权限: public_repo (读取公共仓库信息)
GITHUB_TOKEN=your-github-token-here
# Repository identity 三阶段发布开关；完成 backfill 验收前保持 disabled
REPOSITORY_IDENTITY_CUTOVER=disabled

# BGE-M3 Embedding API (用于生成向量嵌入)
#
# 选项 1: 硅基流动云服务 (推荐，无需本地部署)
# 获取 API Key: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
# BGE-M3 云服务地址
BGE_API_URL=https://api.siliconflow.cn/v1
# BGE-M3 模型名称 (硅基流动)
BGE_MODEL_NAME=BAAI/bge-m3
#
# 选项 2: Xinference 本地服务
# 安装 Xinference:
#   pip install xinference
#
# 启动 BGE-M3 模型:
#   xinference launch --model-name bge-m3 --model-type embedding
#
# 本地地址:
#BGE_API_URL=http://localhost:9997/v1
#BGE_MODEL_NAME=bge-m3
#
# 其他可用的 BGE-M3 服务:
# - LocalAI: http://localhost:8080/v1
# - OpenAI 兼容接口: 根据实际配置

# OpenAI API (备选 embedding 服务，不推荐使用)
# OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# Server
# ============================================================================
# API 服务器端口（默认 3100，避免与前端 3000 冲突）
PORT=3100
API_PORT=3100

# Next.js 服务端反向代理目标
# 浏览器统一请求同源的 /api/trpc 和 /api/agent 路径
API_REWRITE_TARGET=http://localhost:3100

# API 内 scheduler（生产按需启用；本地默认关闭）
ENABLE_SCHEDULER=false
SCHEDULER_TIMEZONE=Asia/Shanghai

# 持久任务 Worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_DURATION_MS=300000
WORKER_RECOVERY_INTERVAL_MS=60000
WORKER_RETRY_DELAY_MS=60000

# 技术栈实体迁移状态；当前 revision 仅支持 legacy_shadow_dual_write。
TECHNOLOGY_STACK_STORAGE_MODE=legacy_shadow_dual_write

# ============================================================================
# 真实 PostgreSQL 集成测试（本地可选，CI 必跑）
# ============================================================================
# TEST_DATABASE_URL 只允许指向 admin 入口（postgres 库）；测试库名一律由
# runner 唯一派生（devscope_test_*）并在结束时删除。危险/业务库名 fail closed。
# 三者必须同时满足：TEST_DATABASE_URL + TEST_DATABASE_DESTRUCTIVE=1 + NODE_ENV=test
#TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
#TEST_DATABASE_DESTRUCTIVE=1

# 图重建外呼预算（deps.dev resolution / GitHub canonicalization / SBOM backfill）
# 默认值覆盖日期化冷启动基线（约 6000 deps.dev miss + 3053 canonicalization）并留 headroom；
# 任一 provider 预算耗尽时在图原子提交前 fail closed，cache receipt 保留给下一次 attempt。
# 非法值（越界/非整数）会让 Worker 启动即失败。
#DEPS_DEV_TIMEOUT_MS=15000          # 1000-60000
#GITHUB_TIMEOUT_MS=15000            # 1000-60000
#GRAPH_DEPS_CONCURRENCY=4           # 1-8，保守个位数并发
#GRAPH_GITHUB_CONCURRENCY=3         # 1-8
#GRAPH_PACING_MS=100                # 0-5000，相邻外呼最小间隔
#GRAPH_DEPS_REQUEST_BUDGET=10000    # 100-100000
#GRAPH_GITHUB_REQUEST_BUDGET=6000   # 100-100000
#GRAPH_DEPS_RESOLVED_TTL_HOURS=720        # 1-8760
#GRAPH_DEPS_NOT_FOUND_TTL_HOURS=168       # 1-8760
#GRAPH_DEPS_ERROR_RETRY_MINUTES=15        # 1-1440
#GRAPH_CANON_RESOLVED_TTL_HOURS=720       # 1-8760
#GRAPH_CANON_NOT_FOUND_TTL_HOURS=168      # 1-8760
#GRAPH_CANON_ERROR_RETRY_MINUTES=15       # 1-1440

# 前端开发服务器端口（由 Next.js 自动使用 3000）
# NEXT_PORT=3000  # Next.js 使用内置配置
